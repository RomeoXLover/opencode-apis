# ==============================================================================
# OpenCode APIs - Environment Configuration
# ==============================================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# Backend Inference URL (Default: local Ollama on VPS)
BACKEND_TYPE=ollama
BACKEND_URL=http://127.0.0.1:11434

# Security Settings
# Set to 'true' to require Bearer tokens in Authorization header
REQUIRE_API_KEY=false

# Comma-separated list of authorized client API keys
API_KEYS=sk-opencode-key1,sk-opencode-key2

# Rate Limiting (slowapi syntax: "count/interval")
RATE_LIMIT_PER_MINUTE=60/minute

# Default model when none is specified
DEFAULT_MODEL=qwen2.5-coder:7b

# ==============================================================================
# Upstream Hybrid Routing (For Claude 3.5 Sonnet, GPT-4o, Gemini 1.5 Pro)
# ==============================================================================
# Set your OpenRouter, Anthropic, or OpenAI API key here to automatically route
# requests for closed models through your VPS API gateway!
ENABLE_UPSTREAM_ROUTER=true
UPSTREAM_API_KEY=sk-or-v1-YOUR_OPENROUTER_OR_ANTHROPIC_KEY_HERE
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
